{
  "extends": ["expo/tsconfig.base", "@bna-ui/typescript-config/expo.json"],
  "compilerOptions": {
    // Workspace hoisting puts @types/node in scope, which makes `setTimeout`
    // resolve to Node's overload (returns Timeout) instead of React Native's
    // (returns number). Pin the ambient types to what an Expo app actually has.
    "types": ["expo/types"],
    "paths": {
      "@/components/ui/*": ["../../packages/registry/src/components/ui/*"],
      "@/components/charts/*": [
        "../../packages/registry/src/components/charts/*"
      ],
      "@/demo/*": ["../../packages/registry/src/demo/*"],
      "@/hooks/*": ["../../packages/registry/src/hooks/*"],
      "@/providers/*": ["../../packages/registry/src/providers/*"],
      "@/theme/*": ["../../packages/registry/src/theme/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/registry/src/**/*.ts",
    "../../packages/registry/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
