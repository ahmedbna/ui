# Written automatically by `npx convex dev --once` the first time you run it.
# Copy this to .env.local only if you need to set it by hand.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time.
# Anyone with the app can read this one — it is just a URL, not a credential.
#
# Everything else — AUTH_RESEND_KEY, AUTH_GOOGLE_ID/SECRET, AUTH_APPLE_ID/SECRET,
# EXPO_URL, SITE_URL — lives on your Convex deployment, set with
# `npx convex env set NAME value`, not here. Server-side functions read them;
# a value in this file would only reach the client.

EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
