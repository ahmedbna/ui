# Copy to .env.local and fill in from your project's API settings:
# https://supabase.com/dashboard/project/_/settings/api
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time.
# Anyone with the app can read them. That is fine for these two — the
# publishable key is scoped by your RLS policies — and never fine for a secret
# key (`sb_secret_…`), which bypasses RLS entirely. Secret keys belong in edge
# function environment variables only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
