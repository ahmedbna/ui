{
  "name": "@bna-ui/registry",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Single source of truth for every BNA UI component, hook, theme file and demo.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json && rm -rf dist/generated/r && cp -R generated/r dist/generated/r && node scripts/verify-payloads.mjs",
    "dev": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.src.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf generated dist .turbo",
    "verify": "node scripts/verify-payloads.mjs"
  },
  "dependencies": {
    "zod": "3.25.56"
  },
  "devDependencies": {
    "@bna-ui/typescript-config": "workspace:*",
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@types/node": "^22.10.2",
    "@types/react": "~19.0.10",
    "expo": "~53.0.9",
    "expo-audio": "~0.4.6",
    "expo-blur": "~14.1.4",
    "expo-camera": "~16.1.8",
    "expo-constants": "~17.1.6",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.10",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.5",
    "expo-location": "~18.1.5",
    "expo-media-library": "~17.1.7",
    "expo-router": "~5.0.6",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.4",
    "expo-system-ui": "~5.0.7",
    "expo-video": "~2.2.1",
    "expo-web-browser": "~14.1.6",
    "lucide-react-native": "^0.511.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.57.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-controller": "^1.17.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.50"
  }
}
