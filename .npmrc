# Metro resolves the workspace via metro.config.js (nodeModulesPaths +
# disableHierarchicalLookup), so pnpm's default isolated linker is fine and
# keeps dependency boundaries honest.
strict-peer-dependencies=false
auto-install-peers=true

# React Native's toolchain reaches for transitive deps it doesn't declare.
public-hoist-pattern[]=*tslib*
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=*eslint*
